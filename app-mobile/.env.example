EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_BOT_API_URL=

# Ver comentario em .env — necessario desde a SDK 56 (expo/fetch como
# globalThis.fetch padrao) pra manter o fetch do React Native e nao quebrar
# o Jest nem mudar o comportamento de rede em producao.
EXPO_PUBLIC_USE_RN_FETCH=1
