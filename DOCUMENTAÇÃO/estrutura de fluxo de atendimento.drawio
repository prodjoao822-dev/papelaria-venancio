        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TD\n  subgraph CLIENTE[\&quot;1. CLIENTE\&quot;]\n    C1[\&quot;Cliente inicia contato via WhatsApp ou chega no balcao\&quot;]\n  end\n\n  subgraph ATEND[\&quot;2. ATENDIMENTO - Bot, IA e Operador\&quot;]\n    A0[\&quot;Redis: debounce e consolidacao de mensagens multiplas\&quot;]\n    A1[\&quot;Bot: triagem e classificacao de midia\&quot;]\n    A2{\&quot;Fila de atendimento com capacidade?\&quot;}\n    A3[\&quot;Cliente aguarda: posicao na fila e tempo estimado\&quot;]\n    A4{\&quot;Roteamento por intencao\&quot;}\n    A5[\&quot;Agente de IA consultivo - Vendas/Orcamento\&quot;]\n    A6[\&quot;IA pergunta: genero, cor/estampa, faixa de preco\&quot;]\n    A7[\&quot;Consulta RAG + Catalogo - com categoria\&quot;]\n    A8[\&quot;Cliente pediu foto? Envia PDF pronto por categoria\&quot;]\n    A9[\&quot;Operador humano atende\&quot;]\n    A10[\&quot;Grupo WhatsApp especifico\&quot;]\n    A11{\&quot;Produto disponivel?\&quot;}\n    A12[\&quot;Registra em Lista de Espera - RF-04\&quot;]\n    A13[\&quot;Operador corrige contexto se a IA errar\&quot;]\n  end\n\n  subgraph ORCPED[\&quot;3. ORCAMENTO e PEDIDO\&quot;]\n    O1[\&quot;Orcamento em rascunho\&quot;]\n    O2[\&quot;Orcamento enviado - aguardando cliente\&quot;]\n    O3{\&quot;Cliente aceita o orcamento?\&quot;}\n    O4[\&quot;RPC aceitar_orcamento: orcamento vira pedido\&quot;]\n    O5[\&quot;Pedido de balcao criado direto pelo Operador - sem F10\&quot;]\n    O6[\&quot;Pedido registrado - RF-02: cliente, itens, retirada/entrega, pagamento, ref. Shop Control\&quot;]\n    O7{\&quot;Cliente pede alteracao no pedido?\&quot;}\n    O8[\&quot;Operador avalia impacto da alteracao\&quot;]\n  end\n\n  subgraph SEPAR[\&quot;4. SEPARACAO\&quot;]\n    S1{\&quot;Ate 7 itens e prioridade imediata?\&quot;}\n    S2[\&quot;Separacao Rapida pelo proprio Operador - RN-01\&quot;]\n    S3[\&quot;Operador delega a um Separador - define prioridade\&quot;]\n    S4[\&quot;Push imediato ao Separador - RF-08\&quot;]\n    S5[\&quot;Separador abre checklist agrupado por categoria\&quot;]\n    S6[\&quot;Separador confere item a item\&quot;]\n    S7{\&quot;Ocorrencia? item faltando, duvida ou substituicao\&quot;}\n    S8[\&quot;Chat interno: Separador avisa Operador - RF-07\&quot;]\n    S9[\&quot;Operador decide: substitui, cancela ou contata cliente\&quot;]\n    S10[\&quot;Separador corrige e continua a separacao\&quot;]\n    S11[\&quot;Separador aciona Separacao Pronta\&quot;]\n    S12[\&quot;Push em tempo real ao Operador - RF-08\&quot;]\n  end\n\n  subgraph CONF[\&quot;5. CONFERENCIA\&quot;]\n    CF1[\&quot;Operador confere a separacao concluida\&quot;]\n    CF2[\&quot;Pedido muda para status Pronto\&quot;]\n  end\n\n  subgraph LOG[\&quot;6. RETIRADA / ENTREGA\&quot;]\n    L1{\&quot;Modalidade: retirada na loja ou entrega?\&quot;}\n    L2[\&quot;Item fica na area de retirada, identificado com o codigo do pedido\&quot;]\n    L3[\&quot;Cliente comparece e informa o codigo do pedido\&quot;]\n    L4[\&quot;Operador confere o codigo e libera o item\&quot;]\n    L5[\&quot;Pedido pronto encaminhado ao Entregador\&quot;]\n    L6[\&quot;Entregador recebe pedido e rota - App Mobile\&quot;]\n    L7[\&quot;Entregador realiza a entrega\&quot;]\n    L8[\&quot;Entregador marca como entregue\&quot;]\n  end\n\n  subgraph CONCL[\&quot;7. CONCLUSAO\&quot;]\n    CN1[\&quot;Pedido finalizado\&quot;]\n    CN2[\&quot;Historico e auditoria: responsavel e timestamp em cada etapa\&quot;]\n    CN3[\&quot;Tarefa agendada se houver follow-up pendente - RF-03\&quot;]\n  end\n\n  C1 --&gt; A0 --&gt; A1 --&gt; A2\n  A2 --&gt;|\&quot;sim\&quot;| A4\n  A2 --&gt;|\&quot;fila cheia\&quot;| A3 --&gt; A4\n  A4 --&gt;|\&quot;alta intencao, cotacao pronta\&quot;| A9\n  A4 --&gt;|\&quot;duvida geral, precisa qualificar\&quot;| A5\n  A4 --&gt;|\&quot;fluxo especifico\&quot;| A10\n  A5 --&gt; A6 --&gt; A7\n  A7 --&gt; A11\n  A11