# Config MCP local — .mcp.json passou a carregar DATABASE_URL (senha real do
# Postgres do Supabase) direto no campo "env" do servidor "supabase" (ver
# servidor supabase/supabase-mcp-server/), porque o dotenv relativo ao cwd
# não resolvia o .env do servidor quando o Claude Code sobe o processo stdio.
# Nunca versionar.
/.mcp.json

# Clone de terceiros do supabase-mcp-server (ferramenta local de MCP, ~24 MB com
# node_modules, e contém um .env real com credencial do Supabase). Fica no disco
# porque o .mcp.json aponta pra cá, mas nunca entra no versionamento do monorepo.
/servidor supabase/

# Export de workflow n8n de exemplo (material de aula de terceiros). NÃO versionar:
