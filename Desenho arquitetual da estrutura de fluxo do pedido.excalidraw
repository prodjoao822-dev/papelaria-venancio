      "versionNonce": 430534250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786997565228,
      "link": null,
      "locked": false,
      "text": "Pessoas responsáveis pela a separação do das listas escolares\nou produtos, vão operar com app mobile que recebe as solicitações dos operadores\nque atendem pelo whatsapp, seguindo o fluxo cliente -> Atendimento -> Pedido - > Preparação - > SEPARAÇÃO \nNa separação, a pessoa no app vai olhar todos  \n\n",
      "fontSize": 122.40112304687483,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pessoas responsáveis pela a separação do das listas escolares\nou produtos, vão operar com app mobile que recebe as solicitações dos operadores\nque atendem pelo whatsapp, seguindo o fluxo cliente -> Atendimento -> Pedido - > Preparação - > SEPARAÇÃO \nNa separação, a pessoa no app vai olhar todos  \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
