# ─────────────────────────────────────────────────────────────────────────────
# VENÂNCIO AI OPERATIONS — Configuração de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — obrigatório
# É O MESMO PROJETO do papelaria-bot (chatbot/papelaria-bot/.env, SUPABASE_URL) —
# não é mais um projeto separado. Encontre a anon key em:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI

# App
VITE_APP_NAME=Venâncio Operations
VITE_APP_VERSION=1.0.0

# n8n — preparado para integração futura
# VITE_N8N_WEBHOOK_BASE=https://seu-n8n.dominio.com/webhook

# Evolution API — preparado para integração WhatsApp futura
# VITE_EVOLUTION_API_URL=https://sua-evolution-api.com
# VITE_EVOLUTION_API_KEY=sua-chave-aqui
