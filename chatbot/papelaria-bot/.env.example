# URL base da instância da Evolution API
EVOLUTION_API_URL=

# Chave de autenticação (API key) da Evolution API
EVOLUTION_API_KEY=

# Nome da instância configurada na Evolution API
EVOLUTION_INSTANCE=

# Token secreto usado para validar as requisições recebidas no webhook
WEBHOOK_SECRET_TOKEN=

# URL do projeto Supabase
SUPABASE_URL=

# Chave de serviço (service role) do Supabase, usada no backend
SUPABASE_SERVICE_KEY=

# Número de telefone do chefe, notificado sobre assuntos financeiros
PHONE_CHEFE=

# Número de telefone do setor de compras
PHONE_COMPRAS=

# Número de telefone do setor de serviços gráficos
PHONE_SERVICOS=

# Número de telefone da Vanessa, responsável pelo atendimento de vendas
PHONE_VANESSA=

# Tempo em minutos de inatividade após o qual o bot é reativado automaticamente (padrão sugerido: 120)
REACTIVATION_TIMEOUT_MINUTES=120

# Porta em que o servidor Express escuta localmente (padrão: 3000)
PORT=3000

# URL do webhook do Agente de Orçamento no n8n (opcional; sem ela o bot só loga um aviso e segue).
# ATENÇÃO ao copiar a URL do n8n: use a de PRODUÇÃO (/webhook/...), nunca a de teste
# (/webhook-test/...). A de teste só responde a UMA chamada depois de clicar "Execute workflow"
# no canvas; fora disso devolve 404 "webhook is not registered" mesmo com o workflow ativo.
N8N_ORCAMENTO_WEBHOOK_URL=

# URL do webhook do Agente de Vendas no n8n (opcional, mas essa chamada é síncrona e faz parte
# do fluxo principal — sem ela, toda consulta em AGENTE_VENDAS_ATIVO cai direto na rede de segurança)
N8N_VENDAS_WEBHOOK_URL=

# Timeout em milissegundos da chamada síncrona ao Agente de Vendas (padrão: 55000 — a latência real
# medida em produção em 11/08/2026 foi de 14-34s; um default menor estoura em toda conversa e deixa
# a execução do n8n órfã, reproduzindo o incidente de pedidos duplicados. Não reduzir sem medir de novo)
AGENTE_VENDAS_TIMEOUT_MS=55000

# Origem(ns) (schema+host+porta) do dashboard (venancio-ai-ops), usada no CORS das rotas
# /operador/* (envio manual de mensagem, notificação de Consultas IA — ver
# src/dashboard/operadorController.js). Aceita uma lista separada por vírgula, sem espaço depois
# da vírgula ou com (o código dá trim): o Vite do dashboard troca de porta sozinho (3000 -> 3001,
# 3002...) sempre que a porta padrão já está ocupada, e um valor único fixo aqui quebra o CORS
# assim que isso acontece. Em produção, inclua o domínio real do dashboard na lista também.
DASHBOARD_ORIGIN=http://localhost:3000,http://localhost:3001

# Token enviado no header x-n8n-webhook-token ao chamar o webhook do Agente de Vendas no n8n
# (opcional, mas recomendado — o webhook passou a exigir uma credential Header Auth, ver
# chatbot/AGENTES N8N/AGENTE_VENDAS.json, node "Webhook · Agente Vendas"). Configure o mesmo
# valor nos dois lados.
N8N_VENDAS_WEBHOOK_TOKEN=

# Chave da OpenRouter, usada por src/utils/mediaProcessor.js pra transcrever áudio e descrever
# imagem recebidos do cliente (PROMPT-03, Entrega 2). Opcional: sem ela, o bot cai no fallback
# de sempre (avisar a equipe de vendas) em vez de processar com IA.
OPENROUTER_API_KEY=
