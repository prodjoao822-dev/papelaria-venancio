# URL base da instância da Evolution API
EVOLUTION_API_URL=

# Chave de autenticação (API key) da Evolution API
EVOLUTION_API_KEY=

# Nome da instância configurada na Evolution API
EVOLUTION_INSTANCE=

# Token secreto usado para validar as requisições recebidas no webhook
WEBHOOK_SECRET_TOKEN=

# URL do projeto Supabase
SUPABASE_URL=

# Chave de serviço (service role) do Supabase, usada no backend
SUPABASE_SERVICE_KEY=

# Número de telefone do chefe, notificado sobre assuntos financeiros
PHONE_CHEFE=

# Número de telefone do setor de compras
PHONE_COMPRAS=

# Número de telefone do setor de serviços gráficos
PHONE_SERVICOS=

# Número de telefone da Vanessa, responsável pelo atendimento de vendas
PHONE_VANESSA=

# Tempo em minutos de inatividade após o qual o bot é reativado automaticamente (padrão sugerido: 120)
REACTIVATION_TIMEOUT_MINUTES=120

# Porta em que o servidor Express escuta localmente (padrão: 3000)
PORT=3000

# URL do webhook do Agente de Orçamento no n8n (opcional; sem ela o bot só loga um aviso e segue)
N8N_ORCAMENTO_WEBHOOK_URL=

# URL do webhook do Agente de Vendas no n8n (opcional, mas essa chamada é síncrona e faz parte
# do fluxo principal — sem ela, toda consulta em AGENTE_VENDAS_ATIVO cai direto na rede de segurança)
N8N_VENDAS_WEBHOOK_URL=

# Timeout em milissegundos da chamada síncrona ao Agente de Vendas (padrão: 12000 — ajustar após medir
# o tempo real de resposta do agente em produção)
AGENTE_VENDAS_TIMEOUT_MS=12000
